# ============ LLM ============
LLM_PROVIDER=deepseek
# DeepSeek 平台 API Key（默认 LLM 提供方）
DEEPSEEK_API_KEY=sk-your-openai-key
# 可选：切换到 OpenAI GPT-4o 时填写
OPENAI_API_KEY=sk-your-openai-key
DEFAULT_MODEL=deepseek-chat
# ============ 数据存储 ============
# Redis 连接串（短期记忆 / 缓存）
REDIS_URL=redis://localhost:6379/0
# 数据库连接串：开发环境默认 SQLite；生产环境示例：
# postgresql+asyncpg://user:password@localhost:5432/paper_agent
DATABASE_URL=sqlite+aiosqlite:///./paper_agent.db

# ============ 向量数据库 ============
# ChromaDB 持久化目录
CHROMA_DIR=D:/chorm

# ============ 对象存储（OSS） ============
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=

# ============ 图片生成：阿里云通义万相 ============
# DashScope API Key（通义万相 wanx 系列模型）
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_WANX_MODEL=wan2.6-image

# ============ 文献检索 ============
OPENALEX_BASE_URL=https://api.openalex.org
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org
SEMANTIC_SCHOLAR_API_KEY=
